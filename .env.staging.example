# ==============================================================================
# DJGear.ir — Staging VPS Environment Template
# Populate securely on the Staging VPS (never commit real staging `.env`).
# ==============================================================================

# --- Environment Metadata -----------------------------------------------------
APP_ENV=staging
COMPOSE_PROJECT_NAME=djgear_staging

# --- Pinned Runtime Versions (Identical to Local & Production) ----------------
WP_IMAGE_TAG=7.1.5-php8.3-fpm
WOOCOMMERCE_VERSION=11.3.1
MYSQL_IMAGE_TAG=8.4
NGINX_IMAGE_TAG=1.30-alpine
REDIS_IMAGE_TAG=7.4-alpine

# --- Site Configuration -------------------------------------------------------
WP_SITE_URL=https://staging.djgear.ir
WP_SITE_TITLE=DJGear Staging
WP_ADMIN_USER=CHANGE_ME_STAGING_ADMIN
WP_ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN_PASS
WP_ADMIN_EMAIL=staging-ops@djgear.ir
WP_LOCALE=fa_IR

# --- WordPress Debugging (Log Only, Never Display) ----------------------------
WP_ENVIRONMENT_TYPE=staging
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
WP_TABLE_PREFIX=djg_

# --- MySQL 8.4 (Separate Staging DB & Restricted User) ------------------------
MYSQL_DATABASE=djgear_wp_staging
MYSQL_USER=djgear_staging_user
MYSQL_PASSWORD=CHANGE_ME_STAGING_DB_PASS
MYSQL_ROOT_PASSWORD=CHANGE_ME_STAGING_ROOT_PASS

# --- Redis Object Cache -------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASS
REDIS_DATABASE=0
REDIS_PREFIX=djgear_stg_

# --- Staging Mail & Sandbox Integrations (No Live Customer Messages) ----------
MAIL_HOST=CHANGE_ME_STAGING_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_STAGING_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_STAGING_SMTP_PASS
MAIL_FROM_ADDRESS=no-reply@staging.djgear.ir
MAIL_FROM_NAME=DJGear Staging

DJGEAR_SMS_PROVIDER=mock
DJGEAR_PAYMENT_MODE=sandbox
