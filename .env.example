# ==============================================================================
# DJGear.ir — Local Development Environment Template
# Copy this file to `.env` and replace placeholder credentials before starting.
# NEVER commit `.env` to Git.
# ==============================================================================

# --- Environment Metadata -----------------------------------------------------
APP_ENV=development
COMPOSE_PROJECT_NAME=djgear_dev

# --- Pinned Runtime Versions (MUST match Staging & Production) ----------------
WP_IMAGE_TAG=7.1.5-php8.3-fpm
WOOCOMMERCE_VERSION=11.3.1
MYSQL_IMAGE_TAG=8.4
NGINX_IMAGE_TAG=1.30-alpine
REDIS_IMAGE_TAG=7.4-alpine
MAILPIT_IMAGE_TAG=v1

# --- Localhost-Only Host Bindings ---------------------------------------------
APP_HOST_PORT=8080
MAILPIT_HTTP_PORT=8025
MYSQL_LOCAL_PORT=3306

# --- Site Configuration -------------------------------------------------------
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE=DJGear Local Development
WP_ADMIN_USER=djgear_admin
WP_ADMIN_PASSWORD=CHANGE_ME_STRONG_LOCAL_ADMIN_PASS
WP_ADMIN_EMAIL=admin@djgear.local
WP_LOCALE=fa_IR

# --- WordPress Debugging (Development Only) -----------------------------------
WP_ENVIRONMENT_TYPE=development
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
WP_TABLE_PREFIX=djg_

# --- MySQL 8.4 (Dedicated Restricted WordPress User — NEVER use root) ---------
MYSQL_DATABASE=djgear_wp_dev
MYSQL_USER=djgear_wp_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_USER_PASS
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_DB_ROOT_PASS

# --- Redis Object Cache -------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASS
REDIS_DATABASE=0
REDIS_PREFIX=djgear_dev_

# --- Local Mailpit SMTP -------------------------------------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@djgear.local
MAIL_FROM_NAME=DJGear Local

# --- Communication & Payment Adapters (Safe Local Sandboxes Only) -------------
DJGEAR_SMS_PROVIDER=mock
DJGEAR_PAYMENT_MODE=sandbox
