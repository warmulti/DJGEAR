{
  "name": "djgear/djgear-custom-skins",
  "description": "Commercial Custom DJ Skin ordering, authenticated artwork DPI validation, WooCommerce checkout integration, and production tracking for DJGear.ir.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpstan/phpstan": "^2.1",
    "php-stubs/wordpress-stubs": "^6.7",
    "php-stubs/woocommerce-stubs": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "DJGear\\CustomSkins\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DJGear\\CustomSkins\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "lint": "find src tests djgear-custom-skins.php -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test:unit": "phpunit --configuration phpunit.xml.dist",
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M"
  }
}
