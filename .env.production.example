# ==============================================================================
# DJGear.ir — Production Environment Template
# Managed strictly via secret vault / controlled production deployment pipeline.
# NEVER commit real production secrets or access production credentials locally.
# ==============================================================================

# --- Environment Metadata -----------------------------------------------------
APP_ENV=production
COMPOSE_PROJECT_NAME=djgear_prod

# --- Pinned Runtime Versions (Never Silently Upgraded) ------------------------
WP_IMAGE_TAG=7.1.5-php8.3-fpm
WOOCOMMERCE_VERSION=11.3.1
MYSQL_IMAGE_TAG=8.4
NGINX_IMAGE_TAG=1.30-alpine
REDIS_IMAGE_TAG=7.4-alpine

# --- Site Configuration -------------------------------------------------------
WP_SITE_URL=https://djgear.ir
WP_SITE_TITLE=DJGear.ir
WP_LOCALE=fa_IR

# --- WordPress Debugging (DISABLED in Production) -----------------------------
WP_ENVIRONMENT_TYPE=production
WP_DEBUG=false
WP_DEBUG_LOG=false
WP_DEBUG_DISPLAY=false
WP_TABLE_PREFIX=djg_

# --- MySQL 8.4 (Dedicated Production DB & Restricted User) --------------------
MYSQL_DATABASE=djgear_wp_prod
MYSQL_USER=djgear_prod_user
MYSQL_PASSWORD=SET_VIA_SECRET_MANAGER
MYSQL_ROOT_PASSWORD=SET_VIA_SECRET_MANAGER

# --- Redis Object Cache -------------------------------------------------------
REDIS_PASSWORD=SET_VIA_SECRET_MANAGER
REDIS_DATABASE=0
REDIS_PREFIX=djgear_prod_

# --- Production Email, SMS & Payment Adapters ---------------------------------
MAIL_HOST=SET_VIA_SECRET_MANAGER
MAIL_PORT=587
MAIL_USERNAME=SET_VIA_SECRET_MANAGER
MAIL_PASSWORD=SET_VIA_SECRET_MANAGER
MAIL_FROM_ADDRESS=no-reply@djgear.ir
MAIL_FROM_NAME=DJGear.ir

DJGEAR_SMS_PROVIDER=SET_VIA_SECRET_MANAGER
DJGEAR_PAYMENT_MODE=live
