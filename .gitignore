# ==============================================================================
# DJGear.ir — Git Ignore Rules
# NEVER commit secrets, credentials, database dumps, customer data, or uploads.
# ==============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
!.env.staging.example
!.env.production.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# Database Dumps & Backups
*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.dump
*.bak
*.backup
backups/
dumps/

# WordPress Runtime, Uploads & Third-Party Artifacts
wp-content/uploads/
wp-content/upgrade/
wp-content/cache/
wp-content/wflogs/
wp-content/debug.log
wp-content/object-cache.php
wp-content/advanced-cache.php
wp-config.php
wp-config-local.php
*.log

# Node.js / Frontend Tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.vite/
.turbo/
.cache/

# PHP / Composer
vendor/
composer.phar
.phpunit.result.cache

# OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
